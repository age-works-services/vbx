#!/usr/bin/env bash
set -euo pipefail

VBX_ROOT=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
# Shared Linux host checks and canonical project identity.
source "$VBX_ROOT/scripts/host.sh"
source "$VBX_ROOT/scripts/provision-host.sh"
TEMPLATE="$VBX_ROOT/lima/default.yaml"
MOUNT_MARKER='mounts: [] # VBX_PROJECT_MOUNT'
CLEANUP_FILES=()
ACTION=
COMMAND=()
MOUNT_SOURCES=()
MOUNT_TARGETS=()
MOUNT_READONLY=()
MODULES=()
ENV_FILES=()
APT_PACKAGES=()
VBX_LOCKED=false

# Lima can leave host-agent children running. They must not inherit our lock.
run() { printf '+ ' >&2; printf '%q ' "$@" >&2; printf '\n' >&2; "$@" 9>&-; }

release_lock() {
    if [[ "$VBX_LOCKED" == true ]]; then
        flock -u 9 || return
        exec 9>&-
        VBX_LOCKED=false
    fi
}

vbx_usage() {
    printf '%s\n' \
        'Usage: vbx [OPTIONS]' \
        '  --project DIR       Select project (default: current directory)' \
        '  --vscode            Open VS Code' \
        '  --terminal          Open a guest shell' \
        '  --workspace-only    Start the VM without opening a tool' \
        '  --exec COMMAND...   Run a command in the guest (consumes remaining arguments)' \
        '  --stop              Stop this project VM' \
        '  --remove            Delete this project VM and guest-local files' \
        '  --render            Print effective Lima YAML without starting a VM' \
        '  --print-name        Print this project VM name' \
        '  --ssh-config        Print the Include line for host ~/.ssh/config' \
        '  --check             Check Linux host prerequisites' \
        '  -h, --help          Show help'
}

vbx_check_host() {
    local tool
    for tool in perl flock tar; do
        command -v "$tool" >/dev/null || fail "Missing $tool. See $VBX_ROOT/docs/manuals/host-setup.md"
    done
    perl -MJSON::PP -e 1 || fail 'Install Perl with its core JSON::PP module.'
    check_host "${1:-}"
}

select_action() {
    [[ -z "$ACTION" ]] || fail 'Select only one action.'
    ACTION=$1
}

yaml_quote() { local value=${1//\'/\'\'}; printf "'%s'" "$value"; }

load_config() {
    local file=$1 key value
    MOUNT_SOURCES=(); MOUNT_TARGETS=(); MOUNT_READONLY=(); MODULES=(); ENV_FILES=(); APT_PACKAGES=()
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' value || fail 'Incomplete configuration snapshot.'
        case "$key" in
            cpus) CPUS=$value ;;
            memory) MEMORY=$value ;;
            disk) DISK=$value ;;
            default) DEFAULT=$value ;;
            folder) FOLDER=$value ;;
            module) MODULES+=("$value") ;;
            apt) APT_PACKAGES+=("$value") ;;
            envFile) ENV_FILES+=("$value") ;;
            mount)
                MOUNT_SOURCES+=("$value")
                IFS= read -r -d '' value || fail 'Incomplete mount target.'
                MOUNT_TARGETS+=("$value")
                IFS= read -r -d '' value || fail 'Incomplete mount mode.'
                MOUNT_READONLY+=("$value")
                ;;
            *) fail "Unknown snapshot key: $key" ;;
        esac
    done < "$file"
    [[ -n ${CPUS:-} && -n ${MEMORY:-} && -n ${DISK:-} && -n ${DEFAULT:-} && -n ${FOLDER:-} ]] ||
        fail 'Incomplete configuration snapshot.'
}

new_config() {
    command -v perl >/dev/null || fail 'Perl is required for configuration parsing.'
    CONFIG_TEMP=$(mktemp)
    CLEANUP_FILES+=("$CONFIG_TEMP")
    perl "$VBX_ROOT/scripts/config.pl" "$PROJECT" "$PRIMARY" \
        "$VBX_ROOT/config.local/config.yaml" "$PROJECT/.vbx/config.yaml" > "$CONFIG_TEMP"
    load_config "$CONFIG_TEMP"
}

render_vbx() {
    local line i
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            'cpus: '*) printf 'cpus: %s\n' "$CPUS" ;;
            'memory: '*) printf 'memory: %s\n' "$MEMORY" ;;
            'disk: '*) printf 'disk: %s\n' "$DISK" ;;
            "$MOUNT_MARKER")
                printf 'mounts:\n  - location: '; yaml_quote "$PROJECT"
                printf '\n    mountPoint: '; yaml_quote "$PRIMARY"
                printf '\n    writable: true\n'
                for ((i=0; i<${#MOUNT_SOURCES[@]}; i++)); do
                    printf '  - location: '; yaml_quote "${MOUNT_SOURCES[i]}"
                    printf '\n    mountPoint: '; yaml_quote "${MOUNT_TARGETS[i]}"
                    if [[ ${MOUNT_READONLY[i]} == true ]]; then
                        printf '\n    writable: false\n'
                    else printf '\n    writable: true\n'; fi
                done
                ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$TEMPLATE"
}

approve_project() {
    [[ -d "$PROJECT/.vbx" ]] || return 0
    local answer
    [[ -t 0 ]] || fail 'Project .vbx setup requires interactive approval.'
    printf 'Apply project .vbx mounts, modules, home files and setup (with access to guest credentials)? [y/N] ' >&2
    IFS= read -r answer
    [[ "$answer" == y || "$answer" == Y || "$answer" == yes ]] || fail 'Project configuration declined.'
}

register_ssh() {
    local config
    config=$(run limactl list --format '{{.SSHConfigFile}}' "$NAME")
    [[ -f "$config" ]] || fail 'Lima did not report a usable SSH configuration file.'
    mkdir -p -- "$SSH_DIR"
    ln -sfn -- "$config" "$SSH_DIR/$NAME.conf"
}

print_ssh_include() {
    local escaped=${SSH_DIR//\\/\\\\}
    escaped=${escaped//\"/\\\"}
    printf 'Include "%s/*.conf"\n' "$escaped"
}

remove_vm() {
    local status
    status=$(run limactl list --format '{{.Status}}' "$NAME") || return
    case "$status" in
        Running) run limactl stop "$NAME" || return ;;
        Stopped) : ;;
        *) fail "Cannot safely remove $NAME with status: $status" ;;
    esac
    run limactl delete --tty=false "$NAME" || return
    rm -rf -- "$STATE"
    rm -f -- "$SSH_DIR/$NAME.conf"
}

launch_guest() {
    exec limactl shell "--workdir=$PRIMARY" "$NAME" -- bash -eu -c '
        export PATH="$HOME/.local/bin:$PATH"
        if [[ -f "$HOME/.config/vbx/environment.sh" ]]; then
            source "$HOME/.config/vbx/environment.sh"
        fi
        exec "$@"
    ' vbx-exec "$@"
}

vbx_cleanup() {
    local status=$?
    trap - EXIT
    if [[ ${#CLEANUP_FILES[@]} -gt 0 ]]; then rm -f -- "${CLEANUP_FILES[@]}"; fi
    cleanup_bundles || printf 'WARNING: could not remove a temporary setup copy.\n' >&2
    release_lock || printf 'WARNING: could not release the operation lock.\n' >&2
    exit "$status"
}

vbx_main() {
    local selected_project=$PWD names exists=false answer
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) vbx_usage; return ;;
            --project) [[ $# -ge 2 ]] || fail '--project requires a directory.'; selected_project=$2; shift 2 ;;
            --vscode|--terminal|--workspace-only|--stop|--remove|--render|--print-name|--ssh-config|--check)
                select_action "${1#--}"; shift ;;
            --exec)
                select_action exec; shift
                [[ $# -gt 0 ]] || fail '--exec requires a command.'
                COMMAND=("$@"); break ;;
            *) fail "Unknown option: $1" ;;
        esac
    done
    SSH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vbx/ssh"
    if [[ "$ACTION" == ssh-config ]]; then print_ssh_include; return; fi
    if [[ "$ACTION" == check ]]; then vbx_check_host; return; fi
    set_project "$selected_project"
    PRIMARY="/workspaces/${NAME#vbx-}"
    # Stable readable workspace path; the hash belongs to VM identity only.
    PRIMARY=${PRIMARY%-????????????}
    if [[ "$ACTION" == print-name ]]; then printf '%s\n' "$NAME"; return; fi
    trap vbx_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if [[ "$ACTION" == render ]]; then new_config; render_vbx; return; fi
    command -v flock >/dev/null || fail 'flock (util-linux) is required.'
    command -v limactl >/dev/null || fail "Lima is missing. See $VBX_ROOT/docs/manuals/host-setup.md"
    STATE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}/vbx"
    [[ "$STATE_BASE" == /* && "$SSH_DIR" == /* ]] || fail 'XDG paths must be absolute.'
    STATE="$STATE_BASE/instances/$NAME"
    mkdir -p -- "$STATE_BASE/locks"
    exec 9> "$STATE_BASE/locks/$NAME.lock"
    flock -n 9 || fail "Another operation is using $NAME."
    VBX_LOCKED=true
    names=$(run limactl list --format '{{.Name}}')
    if grep -Fxq -- "$NAME" <<< "$names"; then exists=true; fi
    case "$ACTION" in
        stop) [[ "$exists" == true ]] || fail 'Project VM does not exist.'; run limactl stop "$NAME"; return ;;
        remove)
            [[ "$exists" == true ]] || fail 'Project VM does not exist.'
            [[ -t 0 ]] || fail 'Removal requires an interactive terminal.'
            printf 'Delete %s and all guest-local files? Type the VM name: ' "$NAME" >&2
            IFS= read -r answer
            [[ "$answer" == "$NAME" ]] || fail 'Removal cancelled.'
            remove_vm
            return ;;
    esac
    vbx_check_host --quiet
    if [[ "$exists" == true ]]; then
        [[ -f "$STATE/config" ]] || fail 'VM has no VBX snapshot. Remove it explicitly before recreating.'
        load_config "$STATE/config"
        run limactl start --tty=false "$NAME"
    else
        new_config
        approve_project
        local yaml
        yaml=$(mktemp --suffix=.yaml); CLEANUP_FILES+=("$yaml")
        render_vbx > "$yaml"
        run limactl validate "$yaml"
        mkdir -p -- "$STATE"
        chmod 700 "$STATE"
        cp -- "$CONFIG_TEMP" "$STATE/config"
        cp -- "$yaml" "$STATE/lima.yaml"
        prepare_bundle
        printf 'creating\n' > "$STATE/status"
        run limactl start --tty=false "--name=$NAME" "$STATE/lima.yaml"
    fi
    if [[ -f "$STATE/provision.tar" && $(< "$STATE/status") != ready ]]; then
        printf 'setup\n' > "$STATE/status"
        if provision_vm; then
            printf 'ready\n' > "$STATE/status"
        else
            printf 'setup-failed\n' > "$STATE/status"
            printf '%s\n' \
                'ERROR: Guest setup failed. The incomplete VM is kept for inspection.' \
                'Correct the setup inputs, then remove and recreate this disposable VM:' >&2
            printf '  vbx --project %q --remove\n' "$PROJECT" >&2
            printf '  vbx --project %q --workspace-only\n' "$PROJECT" >&2
            exit 1
        fi
    fi
    printf 'ready\n' > "$STATE/status"
    rm -f -- "$STATE/provision.tar"
    register_ssh
    if [[ ${#CLEANUP_FILES[@]} -gt 0 ]]; then rm -f -- "${CLEANUP_FILES[@]}"; CLEANUP_FILES=(); fi
    cleanup_bundles
    release_lock
    ACTION=${ACTION:-$DEFAULT}
    case "$ACTION" in
        workspace-only) printf 'Ready: %s (%s)\n' "$NAME" "$PRIMARY" ;;
        terminal) launch_guest bash -l ;;
        exec) launch_guest "${COMMAND[@]}" ;;
        vscode)
            command -v code >/dev/null || fail 'VS Code command "code" is missing on the host.'
            exec code --remote "ssh-remote+lima-$NAME" "$FOLDER" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then vbx_main "$@"; fi
